# Northwind Ceramics Payment App — Environment Configuration Template
# Copy this file to .env and populate with your test credentials.

# Application Configuration
APP_NAME="Northwind Ceramics Payment App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Shopify App & Dev Store Configuration
# Retrieve from Shopify Partners Dashboard > Apps > northline-supply
SHOPIFY_API_KEY=8579eb7c49b7d014a15598a7a90b0a2d
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=write_products,read_products,write_orders,read_orders,write_customers,read_customers,write_metaobjects,write_metaobject_definitions
SHOPIFY_DEV_STORE=your-dev-store.myshopify.com
SHOPIFY_APP_URL=http://localhost:8000

# Stripe Test Account Configuration (AUD)
# Direct test account for Emma Carter / Northwind Ceramics (Melbourne, AU)
# Retrieve from Stripe Dashboard (Test Mode: https://dashboard.stripe.com/test/apikeys)
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=sk_test_your_secret_key
# Generated via `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=aud

# Database Configuration (PostgreSQL - Integer Cents Schema)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=northwind_payment
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis Configuration (Cache, Queues, Distributed Locks)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue & Cache Drivers
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Transactional Mail (Postmark / SES for production, log for local dev)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@northwindceramics.com.au"
MAIL_FROM_NAME="Northwind Ceramics"

# Monitoring & Error Reporting (Sentry)
SENTRY_LARAVEL_DSN=
