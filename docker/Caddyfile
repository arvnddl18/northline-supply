{
    email {$ACME_EMAIL:admin@northwindceramics.com.au}
    # shortcut: auto-tls requires valid public DNS; falls back to internal if localhost/IP, upgrade when custom domain is routed
}

{$STAGING_DOMAIN:localhost} {
    encode zstd gzip

    reverse_proxy app:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Health check passthrough
    handle /up {
        reverse_proxy app:80
    }

    log {
        output stdout
        format console
    }
}
